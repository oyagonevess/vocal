{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/.prisma/client/**",
        "apps/backend/prisma/schema.prisma"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/frontend/$1"
    }
  ]
}
